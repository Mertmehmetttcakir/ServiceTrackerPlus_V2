# Supabase Configuration
# Projeyi ayağa kaldırmak için kendi Supabase projenizin URL ve anon key'ini buraya yazın.
REACT_APP_SUPABASE_URL=https://your-project-ref.supabase.co
REACT_APP_SUPABASE_ANON_KEY=your-anon-key-here

# App Configuration
REACT_APP_APP_NAME=ServiceTracker Plus
REACT_APP_APP_VERSION=1.0.0

# Hata izleme için Sentry kullanmak istiyorsanız DSN'i buraya ekleyin.
REACT_APP_SENTRY_DSN=

# Not:
# - Bu dosya sadece şablon içindir. 