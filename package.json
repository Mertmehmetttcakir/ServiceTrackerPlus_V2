    "@types/react-dom": "^18.2.19",
    "@vercel/analytics": "^1.5.0",
    "axios": "^1.6.7",
    "dompurify": "^3.0.9",
    "framer-motion": "^11.0.6",
    "jspdf": "^3.0.1",
    "jspdf-autotable": "^5.0.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hook-form": "^7.57.0",
    "react-icons": "^5.0.1",
    "react-router-dom": "^6.30.0",
    "recharts": "^2.15.3",
